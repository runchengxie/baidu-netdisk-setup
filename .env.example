# Copy to the private deployment directory, never store real credentials here.
# Empty values keep settings.json defaults. Use full paths or paths relative to .env.
# Quotes are supported. No variable expansion, shell execution or inline comments.

# Windows-DPAPI-encrypted OAuth authorization file.
BAIDU_MCP_TOKEN_FILE=

# Non-secret AppKey of the SAME application as the authorization.
# Not required for the experience route's ordinary MCP operations.
BAIDU_MCP_APP_KEY=

# File created by save-app-secret.ps1; do not put plaintext SecretKey in .env.
# Defaults to app-secret.json beside settings.json when empty.
BAIDU_MCP_SECRET_FILE=

# With matching refresh credentials, MCPs refresh within 7 days of expiry.
# To select another env file, set BAIDU_MCP_ENV_FILE in the launching process.
